{
  "name": "renderpg-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "workflows:dev": "tsx --env-file=.env workflows/main.ts",
    "workflows:slack": "tsx --env-file=.env workflows/slack/main.ts",
    "slack:sync": "tsx --env-file=.env scripts/slack-sync.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "console": "tsx --env-file=.env src/console/main.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --env-file=.env --test tests/postgres.integration.ts tests/slack-postgres.integration.ts",
    "contract:check": "tsx scripts/check-contract.ts",
    "check": "npm run typecheck && npm run contract:check && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@renderinc/sdk": "^1.2.0",
    "@slack/web-api": "^7.9.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
