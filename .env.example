HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://renderpg:renderpg@127.0.0.1:55432/renderpg
# Keep stable between restarts; generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# anthropic is the real adapter. offline is an explicit deterministic test/demo adapter.
AI_MODE=anthropic
ANTHROPIC_API_KEY=
# Haiku is the fast generation model. It must support structured outputs.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=60000
API_URL=http://127.0.0.1:3000
# inline compiles inside the web process. render starts the compileAdventure workflow.
WORKFLOW_MODE=inline
# WORKFLOW_TASK=renderpg/compileAdventure
# SCENARIO_TASK=fillScenario
# RENDER_API_KEY=
# RENDER_USE_LOCAL_DEV=true
# Local `render workflows dev` loads this file and replaces AI_MODE. Set WORKFLOW_AI_MODE=offline in the shell to force the deterministic adapter.
# Optional override. When unset, the console sends the first Slack story on every new game.
# SCENARIO_PROMPT=
